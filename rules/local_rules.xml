<group name="local,sshd,authentication_failed,brute_force,">
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Multiple failed authentication attempts detected within 120 seconds.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,brute_force,</group>
  </rule>
</group>
